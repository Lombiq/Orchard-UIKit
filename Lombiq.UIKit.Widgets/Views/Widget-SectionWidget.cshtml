@using Lombiq.HelpfulLibraries.OrchardCore.Contents
@using OrchardCore.DisplayManagement

@inject ITaxonomyHelper TaxonomyHelper

@{
    if (Model.Content is not IShape content ||
        Model.ContentItem is not ContentItem contentItem ||
        contentItem.As<SectionWidget>() is not { } section)
    {
        return;
    }

    var uniqueId = $"sectionWidget-{Guid.NewGuid():N}";

    var childrenByType = content
        .Items
        .CastWhere<IShape>()
        .ToDictionary(shape => shape.Metadata.Differentiator);

    var classes = (await TaxonomyHelper
        .GetTermsOfTaxonomyByIdAsync(section.Classes.TaxonomyContentItemId, section.Classes.TermContentItemIds))
        .Select(term => term.DisplayText);
}

@if (section.ImagePosition == SectionWidget.SectionImagePosition.Behind &&
     section.Images.Paths.FirstOrDefault() is { Length: > 0 } imagePath)
{
    <style>
        @('#' + uniqueId) {
            background-image: url('@Orchard.AssetUrl(imagePath)');
        }
    </style>
}

<div id="@uniqueId" class="sectionWidget @string.Join(' ', classes)">
    @if (contentItem.As<HtmlTitlePart>() is { Title.Html: { Length: > 0 } title } )
    {
        @Html.Raw(await HtmlTitlePart.GetHtmlAsync(title, 2, "htmlTitlePart"))
    }

    @if (childrenByType.TryGetValue("MarkdownBodyPart", out var body))
    {
        <div class="markdownBodyPart">
            @await DisplayAsync(body)
        </div>
    }

    @if (section.ImagePosition != SectionWidget.SectionImagePosition.Behind &&
        childrenByType.TryGetValue("SectionWidget-Images", out var images))
    {
    <div class="sectionImages">
        @await DisplayAsync(images)
    </div>
    }

    @if (childrenByType.TryGetValue("FlowPart", out var flow))
    {
        @await DisplayAsync(flow)
    }
</div>
