@using Lombiq.UIKit.Widgets.Constants
@using Lombiq.UIKit.Widgets.Settings
@model CarouselWidgetPartSettingsViewModel

<div>
    <h3>@T["Features"]</h3>
    <div class="form-check">
        <label class="form-check-label" asp-for="Accessibility">@T["Accessibility"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Accessibility" />
        <span class="hint dashed">@T["Enables tabbing and arrow key navigation."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Autoplay">@T["AutoPlay"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Autoplay" />
        <span class="hint dashed">@T["Enables Autoplay."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="AdaptiveHeight">@T["Adaptive Height"]</label>
        <input type="checkbox" class="form-check-input" asp-for="AdaptiveHeight" />
        <span class="hint dashed">@T["Enables adaptive height for single slide horizontal carousels."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Arrows">@T["Arrows"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Arrows" />
        <span class="hint dashed">@T["Enables Prev and Next arrow."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="CenterMode">@T["Center Mode"]</label>
        <input type="checkbox" class="form-check-input" asp-for="CenterMode" />
        <span class="hint dashed">@T["Enables centered view with partial prev/next slides. Use with odd numbered slidesToShow counts."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Dots">@T["Dots"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Dots" />
        <span class="hint dashed">@T["Enables dot indicators (bullets under the carousel)."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Draggable">@T["Draggable"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Draggable" />
        <span class="hint dashed">@T["Enables mouse dragging."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Fade">@T["Fade"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Fade" />
        <span class="hint dashed">@T["Enables fade."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="FocusOnSelect">@T["Focus On Select"]</label>
        <input type="checkbox" class="form-check-input" asp-for="FocusOnSelect" />
        <span class="hint dashed">@T["Enables focus on selected element (click)."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Infinite">@T["Infinite"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Infinite" />
        <span class="hint dashed">@T["Enables infinite loop sliding."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="MobileFirst">@T["Mobile First"]</label>
        <input type="checkbox" class="form-check-input" asp-for="MobileFirst" />
        <span class="hint dashed">@T["Enables that responsive settings use mobile first calculation."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="PauseOnFocus">@T["Pause On Focus"]</label>
        <input type="checkbox" class="form-check-input" asp-for="PauseOnFocus" />
        <span class="hint dashed">@T["Enables that the slider's autoplay will be paused on focus."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="PauseOnHover">@T["Pause On Hover"]</label>
        <input type="checkbox" class="form-check-input" asp-for="PauseOnHover" />
        <span class="hint dashed">@T["Enables that the slider's autoplay will be paused on hover."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="PauseOnDotsHover">@T["Pause On Dots Hover"]</label>
        <input type="checkbox" class="form-check-input" asp-for="PauseOnDotsHover" />
        <span class="hint dashed">@T["Enables that the slider's autoplay will be paused when a dot is hovered."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Swipe">@T["Swipe"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Swipe" />
        <span class="hint dashed">@T["Enables swiping."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="TouchMove">@T["Touch Move"]</label>
        <input type="checkbox" class="form-check-input" asp-for="TouchMove" />
        <span class="hint dashed">@T["Enables slide motion with a touch."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="UseCss">@T["Use CSS"]</label>
        <input type="checkbox" class="form-check-input" asp-for="UseCss" />
        <span class="hint dashed">@T["Enables CSS transitions."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="UseTransform">@T["Use Transform"]</label>
        <input type="checkbox" class="form-check-input" asp-for="UseTransform" />
        <span class="hint dashed">@T["Enables CSS transforms."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="VariableWidth">@T["Variable Width"]</label>
        <input type="checkbox" class="form-check-input" asp-for="VariableWidth" />
        <span class="hint dashed">@T["Enables variable width slides."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="Vertical">@T["Vertical Mode"]</label>
        <input type="checkbox" class="form-check-input" asp-for="Vertical" />
        <span class="hint dashed">@T["Enables vertical slide mode."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="VerticalSwiping">@T["Vertical Swiping"]</label>
        <input type="checkbox" class="form-check-input" asp-for="VerticalSwiping" />
        <span class="hint dashed">@T["Enables vertical swipe mode."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="RightToLeft">@T["Right to Left mode"]</label>
        <input type="checkbox" class="form-check-input" asp-for="RightToLeft" />
        <span class="hint dashed">@T["Makes the slider's direction to become right-to-left."]</span>
    </div>
    <div class="form-check">
        <label class="form-check-label" asp-for="WaitForAnimate">@T["Wait For Animate"]</label>
        <input type="checkbox" class="form-check-input" asp-for="WaitForAnimate" />
        <span class="hint dashed">@T["Ignores requests to advance the slide while animating."]</span>
    </div>
</div>

<div>
    <h3>@T["HTML classes"]</h3>

    <div class="form-group">
        <label asp-for="DotsClass">@T["Dots class"]</label>
        <input type="text" class="form-control" asp-for="DotsClass" />
        <span class="hint">@T["Class for slide indicator dots container."]; @T["Default"]: @DefaultValues.DotsClass</span>
    </div>
    <div class="form-group">
        <label asp-for="AsNavFor">@T["As Nav For"]</label>
        <input type="text" class="form-control" asp-for="AsNavFor" />
        <span class="hint">@T["Sets the slider to be the navigation of other slider (class or ID Name)."]</span>
    </div>
</div>

<div>
    <h3>@T["Custom elements"]</h3>
    <div class="form-group">
        <label asp-for="AppendArrows">@T["Append Arrows"]</label>
        <input type="text" class="form-control" asp-for="AppendArrows" />
        <span class="hint">@T["Changes where the navigation arrows are attached (Selector, htmlString, Array, Element, jQuery object)."]; @T["Default"]: @DefaultValues.AppendArrows</span>
    </div>
    <div class="form-group">
        <label asp-for="AppendDots">@T["Append Dots"]</label>
        <input type="text" class="form-control" asp-for="AppendDots" />
        <span class="hint">@T["Change where the navigation dots are attached (Selector, htmlString, Array, Element, jQuery object)."]; @T["Default"]: @DefaultValues.AppendDots</span>
    </div>
    <div class="form-group">
        <label asp-for="PrevArrow">@T["Prev arrow"]</label>
        <input type="text" class="form-control" asp-for="PrevArrow" />
        <span class="hint">@T["Allows you to select a node or customize the HTML for the Previous arrow."]; @T["Default"]: @DefaultValues.PrevArrow</span>
    </div>
    <div class="form-group">
        <label asp-for="NextArrow">@T["Next arrow"]</label>
        <input type="text" class="form-control" asp-for="NextArrow" />
        <span class="hint">@T["Allows you to select a node or customize the HTML for the Next arrow."]; @T["Default"]: @DefaultValues.NextArrow</span>
    </div>
</div>

<div>
    <h3>@T["Options"]</h3>
    <div class="form-group">
        <label asp-for="AutoplaySpeed">@T["Autoplay Speed"] (@T["ms"])</label>
        <input type="text" class="form-control" asp-for="AutoplaySpeed" />
        <span class="hint">@T["Default"]: @DefaultValues.AutoplaySpeed</span>
    </div>
    <div class="form-group">
        <label asp-for="CenterPadding">@T["Center Padding"]</label>
        <input type="text" class="form-control" asp-for="CenterPadding" />
        <span class="hint">@T["Default"]: @DefaultValues.CenterPadding</span>
    </div>
    <div class="form-group">
        <label asp-for="CssEase">@T["CSS Ease"]</label>
        <input type="text" class="form-control" asp-for="CssEase" />
        <span class="hint">@T["Uses CSS3 Animation Easing."]; @T["Default"]: @DefaultValues.CssEase</span>
    </div>
    <div class="form-group">
        <label asp-for="Easing">@T["Easing"]</label>
        <input type="text" class="form-control" asp-for="Easing" />
        <span class="hint">@T["Adds easing for jQuery animate. Use with easing libraries or default easing methods."]; @T["Default"]: @DefaultValues.Easing</span>
    </div>
    <div class="form-group">
        <label asp-for="EdgeFriction">@T["Edge Friction"]</label>
        <input type="text" class="form-control" asp-for="EdgeFriction" />
        <span class="hint">@T["Resistance when swiping edges of non-infinite carousels."]; @T["Default"]: @DefaultValues.EdgeFriction</span>
    </div>
    <div class="form-group">
        <label asp-for="InitialSlide">@T["Initial Slide"]</label>
        <input type="text" class="form-control" asp-for="InitialSlide" />
        <span class="hint">@T["Slide to start on."]; @T["Default"]: @DefaultValues.InitialSlide</span>
    </div>
    <div class="form-group">
        <label asp-for="LazyLoad">@T["Lazy Load"]</label>
        <input type="text" class="form-control" asp-for="LazyLoad" />
        <span class="hint">@T["Sets lazy loading technique. Accepts 'ondemand' or 'progressive'."]; @T["Default"]: @DefaultValues.LazyLoad</span>
    </div>
    <div class="form-group">
        <label asp-for="RespondTo">@T["Respond To (width)"]</label>
        <input type="text" class="form-control" asp-for="LazyLoad" />
        <span class="hint">@T["Sets width that responsive object responds to. Can be 'window', 'slider' or 'min' (the smaller of the two)."]; @T["Default"]: @DefaultValues.RespondTo</span>
    </div>
    <div class="form-group">
        <label asp-for="Rows">@T["Rows"]</label>
        <input type="text" class="form-control" asp-for="Rows" />
        <span class="hint">@T["Setting to 1 initializes grid mode. Use slidesPerRow to set how many slides should be in each row."]; @T["Default"]: @DefaultValues.Rows</span>
    </div>
    <div class="form-group">
        <label asp-for="Slide">@T["Slide"]</label>
        <input type="text" class="form-control" asp-for="Slide" />
        <span class="hint">@T["Sets the element query to use as slide."]; @T["Default"]: @DefaultValues.Slide</span>
    </div>
    <div class="form-group">
        <label asp-for="SlidesPerRow">@T["Slides per row"]</label>
        <input type="text" class="form-control" asp-for="SlidesPerRow" />
        <span class="hint">@T["With the grid mode initialized via the rows option, this sets how many slides are in each grid row."]; @T["Default"]: @DefaultValues.SlidesPerRow</span>
    </div>
    <div class="form-group">
        <label asp-for="SlidesToShow">@T["Slides to show"]</label>
        <input type="text" class="form-control" asp-for="SlidesToShow" />
        <span class="hint">@T["Sets number of slides to show."]; @T["Default"]: @DefaultValues.SlidesToShow</span>
    </div>
    <div class="form-group">
        <label asp-for="SlidesToScroll">@T["Slides to scroll"]</label>
        <input type="text" class="form-control" asp-for="SlidesToScroll" />
        <span class="hint">@T["Sets number of slides to scroll."]; @T["Default"]: @DefaultValues.SlidesToScroll</span>
    </div>
    <div class="form-group">
        <label asp-for="Speed">@T["Speed"] (@T["ms"])</label>
        <input type="text" class="form-control" asp-for="Speed" />
        <span class="hint">@T["Sets slide/fade animation speed."]; @T["Default"]: @DefaultValues.Speed</span>
    </div>
    <div class="form-group">
        <label asp-for="TouchThreshold">@T["Touch Treshold"]</label>
        <input type="text" class="form-control" asp-for="TouchThreshold" />
        <span class="hint">@T["To advance slides, the user must swipe a length of (1/touchThreshold) * the width of the slider."]; @T["Default"]: @DefaultValues.TouchThreshold</span>
    </div>
    <div class="form-group">
        <label asp-for="ZIndex">@T["Z Index"]</label>
        <input type="text" class="form-control" asp-for="ZIndex" />
        <span class="hint">@T["Sets the Z-index values for slides. This is useful for IE9 and lower."]; @T["Default"]: @DefaultValues.ZIndex</span>
    </div>
</div>
