@using Lombiq.HelpfulLibraries.OrchardCore.Contents

@{
    if ((Model?.ContentItem as ContentItem)?.TryGet<QueryContentItemsWidget>(out var part) != true)
    {
        return;
    }
}

<shape type="QueryContentItemsWidget"
       prop-DefaultDisplayType="@CommonContentDisplayTypes.Detail"
       prop-Part="@part"></shape>
