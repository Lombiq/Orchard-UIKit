@using static Lombiq.UIKit.Constants.Classes

@inject IHtmlGenerator HtmlGenerator

@{
    var viewModel = (UiKitEditorViewModel)Model.ViewModel;
    var customBlockClasses = viewModel.BlockClassName;

    var inputClasses = new List<string> { DropdownInputClass };
    var inputAttributes = new Dictionary<string, object>
    {
        ["type"] = "hidden",
    };

    var labelClasses = new List<string> { DropdownLabelClass };
    var labelAttributes = new Dictionary<string, object>();

    var isRequired = viewModel.For.Metadata.RequiredAttributeExists();
    if (isRequired)
    {
        inputAttributes["required"] = string.Empty;
        inputClasses.Add(DropdownInputRequiredClass);
        labelClasses.Add(DropdownLabelRequiredClass);
    }

    if (viewModel.Disabled)
    {
        inputAttributes["disabled"] = string.Empty;
    }

    var label = viewModel.Label != null
        ? HtmlGenerator.GenerateLabel(
            viewModel.ViewContext,
            viewModel.For.ModelExplorer,
            viewModel.For.Name,
            viewModel.Label?.Value,
            labelAttributes.WithClasses(labelClasses))
        : null;

    var input = HtmlGenerator.GenerateTextBox(
        viewModel.ViewContext,
        viewModel.For.ModelExplorer,
        viewModel.For.Name,
        viewModel.For.Model,
        string.Empty,
        inputAttributes.WithClasses(inputClasses));

    var defaultData = viewModel.DropdownData.FirstOrDefault(data => data.DataState.Equals(viewModel.For.Model)) ?? new();

    var disabled = viewModel.Disabled ? "disabled" : string.Empty;

    var containerId = string.IsNullOrWhiteSpace(viewModel.ButtonContainerId)
        ? $"{viewModel.ButtonId}_Container"
        : viewModel.ButtonContainerId;
}

<style asp-name="@ResourceNames.LombiqDropdownStyle"></style>

<div id="@viewModel.DropdownContainerId" class="@customBlockClasses @DropdownBlockName">
    @label
    @input
    <div asp-validation-class-for="@viewModel.For">
        <div id="@containerId" class="@DropdownButtonContainerClass dropdown">
            <button class="btn btn-sm dropdown-toggle @DropdownButtonClass @defaultData.DataClass"
                    title="@viewModel.For.Model"
                    @disabled
                    type="button"
                    id="@viewModel.ButtonId"
                    data-bs-toggle="dropdown"
                    data-selected-class="@defaultData.DataClass">
                @defaultData.Text
            </button>
            <ul class="dropdown-menu dropdown-menu-right @DropdownItemContainerClass">
                @foreach (var dropdownItem in viewModel.DropdownData)
                {
                    <li class="@DropdownItemParentClass">
                        <a href="javascript:void(0)"
                           data-state="@dropdownItem.DataState"
                           data-state-text="@dropdownItem.Text"
                           data-class="@dropdownItem.DataClass"
                           data-button-class="@dropdownItem.DataClass"
                           class="dropdown-item @DropdownItemClass">
                            @dropdownItem.Text
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<script asp-name="@ResourceNames.LombiqDropdownScript" at="Foot"></script>
<script at="Foot" depends-on="@ResourceNames.LombiqDropdownScript">
    dropdownOnClick(
        @containerId.JsonHtmlContent(),
        @viewModel.ButtonId.JsonHtmlContent(),
        @viewModel.For.Name.JsonHtmlContent(),
        @Json.Serialize(viewModel.HideSelectedFromDropdownList));
</script>
